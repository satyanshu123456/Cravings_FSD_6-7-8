# Server Environment Template
PORT=5000
NODE_ENV=production
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/cravings
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=https://cravings-fsd-6-7-8.vercel.app

# Razorpay Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional Email Service (Gmail SMTP)
GMAIL_USERNAME=your_email@gmail.com
GMAIL_PASSCODE=your_app_password

